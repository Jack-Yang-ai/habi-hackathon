# Default: private local development. HOST=0.0.0.0 requires both tokens below.
HOST=127.0.0.1
PORT=8787
DATA_DIR=.data
# APP_ACCESS_TOKEN=
# DEVICE_ACCESS_TOKEN=
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# StepFun: fill this key to use health-agent's step-1o-turbo-vision default.
STEPFUN_API_KEY=
# CHAT_MODEL_NAME=step-1o-turbo-vision
# Optional compatible model service. Manual photos require explicit analysis.
# Automatic first-frame vision is enabled by the app's capture+recognition switch.
# FOOD_MODEL_BASE_URL=https://api.stepfun.com/v1
# FOOD_MODEL_API_KEY=
# FOOD_MODEL_NAME=
# MODEL_TIMEOUT_MS=30000

# Selected local Decider service (AgentJev-compatible adapter). Not actual intake.
# JEV_URL=http://127.0.0.1:8150
# JEV_TIMEOUT_MS=15000

# Nearby dining: Web Service API key, server only. Never use a VITE_ variable.
AMAP_WEB_SERVICE_KEY=
# AMAP_TIMEOUT_MS=8000
# AMAP_SEARCH_KEYWORDS_MAX=1
# Proactive recommendations stay off until POST /api/dining/preferences enables them.

# Live integration check against the deployed Mac mini (docs/device/REMOTE_INTEGRATION.md).
# Tokens are the Mac mini's own two credentials; keep real values only in this Git-ignored .env.
# HABI_REMOTE_BASE_URL=https://habi.zhexin.site
# HABI_REMOTE_APP_TOKEN=
# HABI_REMOTE_DEVICE_TOKEN=

